# ---- Google OAuth (read-only Gmail) -----------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and enable the Gmail API.
# Add this exact redirect URI to the client:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if the app is not reachable at the origin it is served from
# (e.g. behind a proxy). Must match the client's registered redirect exactly.
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback

# ---- Session encryption ------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 48
# Rotating this invalidates every existing session.
SESSION_SECRET=

# ---- TypeSafe JEV ------------------------------------------------------------
# API key from https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional. Defaults to jev-latest; pin a version for reproducibility.
# TYPESAFE_MODEL=jev-latest

# ---- Limits ------------------------------------------------------------------
# Ceiling on messages pulled per run. Each message costs one JEV request.
# MAX_MESSAGES=150
